{
  "doctype": "DocType",
  "name": "Bitemporal Import",
  "module": "Kartoza",
  "custom": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "is_submittable": 0,
  "engine": "InnoDB",
  "autoname": "BITEMP-.#####",
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Accounts User", "read": 1}
  ],
  "fields": [
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "in_list_view": 1, "reqd": 1},
    {"fieldname": "description", "label": "Description", "fieldtype": "Small Text"},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "in_list_view": 1},
  {"fieldname": "input_type", "label": "Input Type", "fieldtype": "Select", "options": "CSV\nJSONS", "default": "CSV", "reqd": 1},
    {"fieldname": "upload", "label": "Upload CSV/JSON", "fieldtype": "Attach", "reqd": 1},
    {"fieldname": "parse_btn", "label": "Parse File", "fieldtype": "Button"},
    {"fieldname": "section_meta", "label": "Meta", "fieldtype": "Section Break"},
    {"fieldname": "source_file_name", "label": "Source File Name", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "rows_count", "label": "Rows", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "column_break_meta", "fieldtype": "Column Break"},
    {"fieldname": "load_example_btn", "label": "Load Example", "fieldtype": "Button"},
    {"fieldname": "section_data", "label": "Bitemporal Rows", "fieldtype": "Section Break"},
    {"fieldname": "rows", "label": "Rows", "fieldtype": "Table", "options": "Bitemporal Import Row"},
    {"fieldname": "column_break_preview", "fieldtype": "Section Break", "label": "Preview"},
    {"fieldname": "preview_html", "label": "Bitemporal Preview", "fieldtype": "HTML"}
  ]
}
